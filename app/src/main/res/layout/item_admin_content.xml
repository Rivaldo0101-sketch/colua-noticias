<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E2E8F0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Encabezado de la Tarjeta Canvas: Tipo de Bloque y Estado -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F8FAFC"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/tv_admin_item_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:fontFamily="@font/poppins_regular"
                android:text="[ TARJETA DE PRODUCTO ]"
                android:textColor="@color/colua_navy"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_admin_item_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/circle_background"
                android:backgroundTint="#E8F5E9"
                android:fontFamily="@font/poppins_regular"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="Publicado"
                android:textColor="#2E7D32"
                android:textSize="10sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E2E8F0" />

        <!-- Vista previa del Contenido Visual del Bloque -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp">

            <View
                android:id="@+id/side_border_admin"
                android:layout_width="5dp"
                android:layout_height="52dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@color/colua_navy" />

            <!-- Ícono o Imagen del Bloque -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_icon_container"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp"
                android:layout_toEndOf="@id/side_border_admin"
                app:cardBackgroundColor="#F1F5F9"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/iv_admin_item_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_star" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Título, Subtítulo y Enlace Destino -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:layout_toEndOf="@id/cv_icon_container"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_admin_item_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:text="Título del Bloque"
                    android:textColor="@color/black"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_admin_item_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_regular"
                    android:maxLines="2"
                    android:text="Descripción corta o beneficios del elemento..."
                    android:textColor="@color/text_grey"
                    android:textSize="12sp" />

                <!-- Enlace de Destino Configurable -->
                <TextView
                    android:id="@+id/tv_admin_item_target_preview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="#F1F5F9"
                    android:fontFamily="@font/poppins_regular"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="Destino: /credito_productivo_detail"
                    android:textColor="#334155"
                    android:textSize="10sp" />
            </LinearLayout>

        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F1F5F9" />

        <!-- Barra de Controles de Gestión del Canvas (Subir, Bajar, Editar, Duplicar, Ocultar, Eliminar) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FAFAFA"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingVertical="4dp">

            <ImageButton
                android:id="@+id/btn_move_up"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Subir"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/punta_de_flecha_hacia_arriba"
                app:tint="@color/colua_navy" />

            <ImageButton
                android:id="@+id/btn_move_down"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Bajar"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/punta_de_flecha_hacia_abajo"
                app:tint="@color/colua_navy" />

            <View
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:background="#E2E8F0" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_edit_item"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:fontFamily="@font/poppins_regular"
                android:text="Editar"
                android:textColor="@color/colua_navy"
                android:textSize="11sp"
                app:icon="@drawable/editar"
                app:iconSize="16dp" />

            <ImageButton
                android:id="@+id/btn_duplicate_item"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Duplicar bloque"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/duplicar" />

            <ImageButton
                android:id="@+id/btn_toggle_visibility"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Vista previa / Visibilidad"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ver" />

            <ImageButton
                android:id="@+id/btn_delete_item"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Eliminar bloque"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/borrar" />

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
