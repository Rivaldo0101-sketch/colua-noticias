<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_preview_banner"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="false"
    android:focusable="false"
    android:elevation="20dp"
    android:visibility="gone">

    <!-- 1. Indicador discreto superpuesto en la esquina superior (Vista previa) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="#CC173789"
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp"
        app:strokeWidth="1dp"
        app:strokeColor="#80FFFFFF">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/circle_background"
                android:backgroundTint="#FFB300" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/poppins_regular"
                android:text="Vista previa"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 2. Botón flotante superpuesto en la parte inferior derecha sobre la navegación pública -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_exit_preview"
        style="@style/Widget.Material3.Button.UnelevatedButton"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="96dp"
        android:fontFamily="@font/poppins_regular"
        android:paddingHorizontal="16dp"
        android:text="Volver"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:textStyle="bold"
        app:backgroundTint="#173789"
        app:cornerRadius="21dp"
        app:elevation="8dp"
        app:strokeColor="#80FFFFFF"
        app:strokeWidth="1dp" />

</FrameLayout>
