<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="20dp">

    <!-- Optional Logo Image above card -->
    <ImageView
        android:id="@+id/card_credito_logo"
        android:layout_width="220dp"
        android:layout_height="70dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="10dp"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:contentDescription="Logo de Crédito" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/card_credito_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Crédito Productivo"
                android:textColor="@color/colua_navy"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins_regular" />

            <TextView
                android:id="@+id/card_credito_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="• Ideal para capital de trabajo..."
                android:textColor="#333333"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.2"
                android:fontFamily="@font/poppins_regular" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_solicitar"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:text="Solicitar Información"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:backgroundTint="@color/colua_navy"
                app:cornerRadius="24dp"
                android:fontFamily="@font/poppins_regular"
                android:textSize="15sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
