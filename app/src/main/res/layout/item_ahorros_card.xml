<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="20dp">

    <!-- Optional Logo Image above card -->
    <ImageView
        android:id="@+id/card_ahorro_logo"
        android:layout_width="240dp"
        android:layout_height="75dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:contentDescription="Logo de Cuenta" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/card_ahorro_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cuenta Aportación Adulto"
                android:textColor="@color/colua_navy"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins_regular" />

            <TextView
                android:id="@+id/card_ahorro_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Es la cuenta que otorga el derecho a la persona natural a asociarse a la cooperativa..."
                android:textColor="#333333"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.2"
                android:fontFamily="@font/poppins_regular" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_conocer_mas"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:text="Conocer Más"
                android:textAllCaps="false"
                android:textColor="@color/colua_navy"
                app:strokeColor="@color/colua_navy"
                app:strokeWidth="1.5dp"
                app:cornerRadius="24dp"
                android:fontFamily="@font/poppins_regular"
                android:textSize="15sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
