<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E2E8F0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header: Título y botón cerrar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_grid_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:fontFamily="@font/poppins_regular"
                android:text="Galería Visual de Recursos"
                android:textColor="@color/colua_navy"
                android:textSize="17sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btn_close_grid_dialog"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Cerrar"
                android:focusable="true"
                android:padding="4dp"
                android:src="@drawable/cerrar"
                app:tint="@color/text_grey" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tv_grid_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/poppins_regular"
            android:text="Toca una imagen o ícono para asignarlo:"
            android:textColor="@color/text_grey"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="#F1F5F9" />

        <!-- Grid de Recursos Visuales -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_resource_grid"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:clipToPadding="false"
            android:scrollbars="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_grid"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/poppins_regular"
            android:text="Cancelar"
            android:textColor="@color/text_grey"
            app:cornerRadius="12dp"
            app:strokeColor="#CBD5E1" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
