<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E2E8F0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Fila Superior e Intermedia: Ícono + Título + Ruta / Orden -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="10dp">

            <!-- Barra vertical de color -->
            <View
                android:id="@+id/side_border_menu"
                android:layout_width="6dp"
                android:layout_height="38dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@color/colua_navy" />

            <!-- Ícono de la pantalla -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_icon_container"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_toEndOf="@id/side_border_menu"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp"
                app:cardBackgroundColor="#F1F5F9"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/iv_menu_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp"
                    android:src="@drawable/ic_star"
                    app:tint="@color/colua_navy"
                    tools:ignore="ContentDescription" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Textos: Título arriba, Ruta / Orden abajo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/card_icon_container"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <!-- Fila 1: Título de la pantalla -->
                <TextView
                    android:id="@+id/tv_menu_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:text="Nombre de la Pantalla"
                    android:textColor="@color/black"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Fila 2: Ruta/slug y Orden -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_menu_path"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_regular"
                        android:text="/home"
                        android:textColor="@color/text_grey"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_menu_order"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/circle_background"
                        android:backgroundTint="#E2E8F0"
                        android:fontFamily="@font/poppins_regular"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:text="Ord: 1"
                        android:textColor="@color/colua_navy"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

        </RelativeLayout>

        <!-- Divisor sutil -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F1F5F9" />

        <!-- Fila 3 (Bottom): Los 4 botones de acción con ícono y texto centrado debajo -->
        <LinearLayout
            android:id="@+id/layout_actions_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingVertical="8dp"
            android:background="#FAFAFA">

            <!-- Botón 1: Cambiar sitio (direccion.png) -->
            <LinearLayout
                android:id="@+id/col_add_content"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingVertical="4dp">

                <ImageView
                    android:id="@+id/btn_add_content"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="Cambiar sitio"
                    android:scaleType="fitCenter"
                    android:src="@drawable/direccion" />

                <TextView
                    android:id="@+id/tv_btn_add_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/poppins_regular"
                    android:text="Cambiar sitio"
                    android:textColor="#334155"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="32dp"
                android:layout_gravity="center_vertical"
                android:background="#E2E8F0" />

            <!-- Botón 2: Detalles (editar.png) -->
            <LinearLayout
                android:id="@+id/col_edit_section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingVertical="4dp">

                <ImageView
                    android:id="@+id/btn_edit_section"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="Detalles"
                    android:scaleType="fitCenter"
                    android:src="@drawable/editar" />

                <TextView
                    android:id="@+id/tv_btn_edit_section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/poppins_regular"
                    android:text="Detalles"
                    android:textColor="#334155"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="32dp"
                android:layout_gravity="center_vertical"
                android:background="#E2E8F0" />

            <!-- Botón 3: Vista previa (ver.png) -->
            <LinearLayout
                android:id="@+id/col_preview_section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingVertical="4dp">

                <ImageView
                    android:id="@+id/btn_preview_section"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="Vista previa"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ver" />

                <TextView
                    android:id="@+id/tv_btn_preview_section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/poppins_regular"
                    android:text="Vista previa"
                    android:textColor="#334155"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="32dp"
                android:layout_gravity="center_vertical"
                android:background="#E2E8F0" />

            <!-- Botón 4: Eliminar (borrar.png) -->
            <LinearLayout
                android:id="@+id/col_delete_section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingVertical="4dp">

                <ImageView
                    android:id="@+id/btn_delete_section"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="Eliminar"
                    android:scaleType="fitCenter"
                    android:src="@drawable/borrar" />

                <TextView
                    android:id="@+id/tv_btn_delete_section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/poppins_regular"
                    android:text="Eliminar"
                    android:textColor="#334155"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
