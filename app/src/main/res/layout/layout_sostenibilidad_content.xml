<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:paddingBottom="60dp">

    <!-- Header Title & Subtitle -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sostenibilidad Cooperativa"
        android:textColor="@color/colua_navy"
        android:textSize="26sp"
        android:textStyle="bold"
        android:fontFamily="@font/poppins_regular"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Construyendo un futuro sostenible a través de la educación y el desarrollo comunitario."
        android:textColor="#555555"
        android:textSize="14sp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.2"
        android:fontFamily="@font/poppins_regular"
        android:layout_marginBottom="24dp" />

    <!-- Section: Nuestros Pilares -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nuestros Pilares"
        android:textColor="@color/colua_navy"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="@font/poppins_regular"
        android:layout_marginBottom="16dp" />

    <!-- Pilar 1: Educación (Orange #EF8819) -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="@color/white">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="20dp"
            android:gravity="center_vertical"
            android:baselineAligned="false">
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_rounded_icon"
                android:backgroundTint="#EF8819"
                android:layout_marginEnd="16dp">
                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_school"
                    app:tint="@color/white"
                    android:contentDescription="Educación" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Educación"
                    android:textColor="@color/colua_navy"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins_regular"
                    android:layout_marginBottom="4dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Programas de formación continua y becas para asociados y sus familias."
                    android:textColor="#555555"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.2"
                    android:fontFamily="@font/poppins_regular" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Pilar 2: Empleabilidad (Pink #E42A67) -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="@color/white">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="20dp"
            android:gravity="center_vertical"
            android:baselineAligned="false">
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_rounded_icon"
                android:backgroundTint="#E42A67"
                android:layout_marginEnd="16dp">
                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_work"
                    app:tint="@color/white"
                    android:contentDescription="Empleabilidad" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Empleabilidad"
                    android:textColor="@color/colua_navy"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins_regular"
                    android:layout_marginBottom="4dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Talleres técnicos y desarrollo de habilidades para la inserción laboral."
                    android:textColor="#555555"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.2"
                    android:fontFamily="@font/poppins_regular" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Pilar 3: Desarrollo Comunitario (Teal #59B8A4) -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="@color/white">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="20dp"
            android:gravity="center_vertical"
            android:baselineAligned="false">
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_rounded_icon"
                android:backgroundTint="#59B8A4"
                android:layout_marginEnd="16dp">
                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_groups"
                    app:tint="@color/white"
                    android:contentDescription="Desarrollo Comunitario" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Desarrollo Comunitario"
                    android:textColor="@color/colua_navy"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins_regular"
                    android:layout_marginBottom="4dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Apoyo a iniciativas locales que fomentan el bienestar colectivo."
                    android:textColor="#555555"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.2"
                    android:fontFamily="@font/poppins_regular" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Pilar 4: Proyectos (Purple #634794) -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="@color/white">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="20dp"
            android:gravity="center_vertical"
            android:baselineAligned="false">
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_rounded_icon"
                android:backgroundTint="#634794"
                android:layout_marginEnd="16dp">
                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_lightbulb"
                    app:tint="@color/white"
                    android:contentDescription="Proyectos" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Proyectos"
                    android:textColor="@color/colua_navy"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins_regular"
                    android:layout_marginBottom="4dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Impulso a emprendimientos sostenibles con impacto ambiental positivo."
                    android:textColor="#555555"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.2"
                    android:fontFamily="@font/poppins_regular" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Section: Ruta de Formación -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ruta de Formación"
        android:textColor="@color/colua_navy"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="@font/poppins_regular"
        android:layout_marginBottom="16dp" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="@color/white">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Step 1 (Updated to match step 2: light gray/blue background #E2E8F0 and colua_navy text) -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="16dp" android:gravity="top">
                <TextView android:layout_width="28dp" android:layout_height="28dp" android:text="1" android:textColor="@color/colua_navy" android:textStyle="bold" android:textSize="14sp" android:background="@drawable/circle_background" android:backgroundTint="#E2E8F0" android:gravity="center" android:layout_marginEnd="12dp" android:layout_marginTop="2dp" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Inducción Cooperativa" android:textColor="@color/colua_navy" android:textSize="15sp" android:textStyle="bold" android:fontFamily="@font/poppins_regular" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Principios y valores del modelo cooperativo." android:textColor="#555555" android:textSize="13sp" android:fontFamily="@font/poppins_regular" />
                </LinearLayout>
            </LinearLayout>

            <!-- Step 2 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="16dp" android:gravity="top">
                <TextView android:layout_width="28dp" android:layout_height="28dp" android:text="2" android:textColor="@color/colua_navy" android:textStyle="bold" android:textSize="14sp" android:background="@drawable/circle_background" android:backgroundTint="#E2E8F0" android:gravity="center" android:layout_marginEnd="12dp" android:layout_marginTop="2dp" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Educación Financiera Básico" android:textColor="@color/colua_navy" android:textSize="15sp" android:textStyle="bold" android:fontFamily="@font/poppins_regular" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Manejo de presupuesto y ahorro personal." android:textColor="#555555" android:textSize="13sp" android:fontFamily="@font/poppins_regular" />
                </LinearLayout>
            </LinearLayout>

            <!-- Step 3 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="16dp" android:gravity="top">
                <TextView android:layout_width="28dp" android:layout_height="28dp" android:text="3" android:textColor="@color/colua_navy" android:textStyle="bold" android:textSize="14sp" android:background="@drawable/circle_background" android:backgroundTint="#E2E8F0" android:gravity="center" android:layout_marginEnd="12dp" android:layout_marginTop="2dp" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Educación Financiera Avanzado" android:textColor="@color/colua_navy" android:textSize="15sp" android:textStyle="bold" android:fontFamily="@font/poppins_regular" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Inversiones, crédito responsable y planificación a largo plazo." android:textColor="#555555" android:textSize="13sp" android:fontFamily="@font/poppins_regular" />
                </LinearLayout>
            </LinearLayout>

            <!-- Step 4 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="16dp" android:gravity="top">
                <TextView android:layout_width="28dp" android:layout_height="28dp" android:text="4" android:textColor="@color/colua_navy" android:textStyle="bold" android:textSize="14sp" android:background="@drawable/circle_background" android:backgroundTint="#E2E8F0" android:gravity="center" android:layout_marginEnd="12dp" android:layout_marginTop="2dp" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Liderazgo Transformacional" android:textColor="@color/colua_navy" android:textSize="15sp" android:textStyle="bold" android:fontFamily="@font/poppins_regular" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Desarrollo de habilidades directivas y gestión de equipos." android:textColor="#555555" android:textSize="13sp" android:fontFamily="@font/poppins_regular" />
                </LinearLayout>
            </LinearLayout>

            <!-- Step 5 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="16dp" android:gravity="top">
                <TextView android:layout_width="28dp" android:layout_height="28dp" android:text="5" android:textColor="@color/colua_navy" android:textStyle="bold" android:textSize="14sp" android:background="@drawable/circle_background" android:backgroundTint="#E2E8F0" android:gravity="center" android:layout_marginEnd="12dp" android:layout_marginTop="2dp" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Emprendimiento e Innovación" android:textColor="@color/colua_navy" android:textSize="15sp" android:textStyle="bold" android:fontFamily="@font/poppins_regular" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Herramientas para crear y escalar negocios sostenibles." android:textColor="#555555" android:textSize="13sp" android:fontFamily="@font/poppins_regular" />
                </LinearLayout>
            </LinearLayout>

            <!-- Step 6 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="top">
                <TextView android:layout_width="28dp" android:layout_height="28dp" android:text="6" android:textColor="@color/colua_navy" android:textStyle="bold" android:textSize="14sp" android:background="@drawable/circle_background" android:backgroundTint="#E2E8F0" android:gravity="center" android:layout_marginEnd="12dp" android:layout_marginTop="2dp" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Certificación de Asociado Activo" android:textColor="@color/colua_navy" android:textSize="15sp" android:textStyle="bold" android:fontFamily="@font/poppins_regular" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Reconocimiento final y acceso a beneficios exclusivos." android:textColor="#555555" android:textSize="13sp" android:fontFamily="@font/poppins_regular" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Banner Card: Programas de Educación y Formación -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="@color/colua_navy">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="28dp">
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_school"
                app:tint="@color/white"
                android:layout_marginBottom="12dp"
                android:contentDescription="Educación" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PROGRAMAS DE EDUCACIÓN Y FORMACIÓN"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:fontFamily="@font/poppins_regular"
                android:layout_marginBottom="8dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Impulsando el desarrollo a través del conocimiento cooperativo."
                android:textColor="#E2E8F0"
                android:textSize="13sp"
                android:gravity="center"
                android:fontFamily="@font/poppins_regular" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Card: ¿Te gustaría participar? -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="@color/white">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="¿Te gustaría participar?"
                android:textColor="@color/colua_navy"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:fontFamily="@font/poppins_regular"
                android:layout_marginBottom="8dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Acércate a tu agencia más cercana para conocer las próximas fechas de nuestros talleres y programas de formación."
                android:textColor="#555555"
                android:textSize="13sp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.2"
                android:fontFamily="@font/poppins_regular"
                android:layout_marginBottom="16dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_solicitar_informacion"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Solicitar Información"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:backgroundTint="@color/colua_navy"
                app:cornerRadius="24dp"
                android:fontFamily="@font/poppins_regular"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Program 1: Programa Wachalal (Pink #E42A67) -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="@color/white">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_rounded_icon"
                    android:backgroundTint="#E42A67"
                    android:layout_marginEnd="12dp">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_groups"
                        app:tint="@color/white"
                        android:contentDescription="Wachalal" />
                </FrameLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Programa Wachalal"
                    android:textColor="@color/colua_navy"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins_regular" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Apoyo nutricional y escolar para niños en zonas vulnerables."
                android:textColor="#333333"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.2"
                android:fontFamily="@font/poppins_regular" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Program 2: Programa Huellas (Teal #59B8A4) -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="@color/white">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_rounded_icon"
                    android:backgroundTint="#59B8A4"
                    android:layout_marginEnd="12dp">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_volunteer_activism"
                        app:tint="@color/white"
                        android:contentDescription="Huellas" />
                </FrameLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Programa Huellas"
                    android:textColor="@color/colua_navy"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins_regular" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Iniciativas de reforestación y cuidado del medio ambiente."
                android:textColor="#333333"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.2"
                android:fontFamily="@font/poppins_regular" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Program 3: Talleres Comunitarios (Purple #634794) -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="@color/white">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <FrameLayout
