<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:paddingBottom="60dp">

    <!-- Header Eje 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_school"
            app:tint="@color/colua_navy"
            android:layout_marginEnd="8dp"
            android:contentDescription="Eje" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EJE 1 • FORMACIÓN TRANSFORMADORA"
            android:textColor="@color/colua_navy"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins_regular" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Educación y Formación Cooperativa"
        android:textColor="@color/colua_navy"
        android:textSize="24sp"
        android:textStyle="bold"
        android:fontFamily="@font/poppins_regular"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Empoderando a la niñez, juventud y comunidades rurales del departamento con herramientas financieras, valores y liderazgo."
        android:textColor="#555555"
        android:textSize="13sp"
        android:lineSpacingMultiplier="1.2"
        android:fontFamily="@font/poppins_regular"
        android:layout_marginBottom="20dp" />

    <!-- Card 1: Programa Wachalal -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="@color/white">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Programa Wachalal" android:textColor="@color/colua_navy" android:textSize="18sp" android:textStyle="bold" android:fontFamily="@font/poppins_regular" android:layout_alignParentStart="true" android:layout_centerVertical="true" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2,284 Alumnos" android:textColor="#2E7D32" android:textSize="12sp" android:textStyle="bold" android:background="@drawable/circle_background" android:backgroundTint="#E8F5E9" android:paddingHorizontal="10dp" android:paddingVertical="4dp" android:layout_alignParentEnd="true" android:layout_centerVertical="true" />
            </RelativeLayout>

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:src="@drawable/sostenibilidad_cooperativa"
                android:scaleType="centerCrop"
                android:layout_marginBottom="12dp"
                android:contentDescription="Wachalal" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Formación lúdica y fomento al ahorro en Concepción, Panajachel, Santiago Atitlán, Sololá y San Juan La Laguna." android:textColor="#333333" android:textSize="13sp" android:lineSpacingMultiplier="1.2" android:fontFamily="@font/poppins_regular" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Card 2: Educación Financiera -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="@color/white">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Educación Financiera" android:textColor="@color/colua_navy" android:textSize="18sp" android:textStyle="bold" android:fontFamily="@font/poppins_regular" android:layout_alignParentStart="true" android:layout_centerVertical="true" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1,305 Personas" android:textColor="#2E7D32" android:textSize="12sp" android:textStyle="bold" android:background="@drawable/circle_background" android:backgroundTint="#E8F5E9" android:paddingHorizontal="10dp" android:paddingVertical="4dp" android:layout_alignParentEnd="true" android:layout_centerVertical="true" />
            </RelativeLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Talleres prácticos en Nahualá, Santiago Atitlán, San Andrés Semetabaj y Concordia Totonicapán." android:textColor="#333333" android:textSize="13sp" android:lineSpacingMultiplier="1.2" android:fontFamily="@font/poppins_regular" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Card 3: Becas Jóvenes Cooperativistas -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="@color/white">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Becas Jóvenes Cooperativistas" android:textColor="@color/colua_navy" android:textSize="18sp" android:textStyle="bold" android:fontFamily="@font/poppins_regular" android:layout_alignParentStart="true" android:layout_centerVertical="true" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="160 Becados" android:textColor="#2E7D32" android:textSize="12sp" android:textStyle="bold" android:background="@drawable/circle_background" android:backgroundTint="#E8F5E9" android:paddingHorizontal="10dp" android:paddingVertical="4dp" android:layout_alignParentEnd="true" android:layout_centerVertical="true" />
            </RelativeLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Impulso académico y mentoría solidaria para nuevas generaciones de líderes locales." android:textColor="#333333" android:textSize="13sp" android:lineSpacingMultiplier="1.2" android:fontFamily="@font/poppins_regular" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Card 4: Programa Huellas -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="@color/white">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Programa Huellas" android:textColor="@color/colua_navy" android:textSize="18sp" android:textStyle="bold" android:fontFamily="@font/poppins_regular" android:layout_alignParentStart="true" android:layout_centerVertical="true" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="436 Atendidos" android:textColor="#2E7D32" android:textSize="12sp" android:textStyle="bold" android:background="@drawable/circle_background" android:backgroundTint="#E8F5E9" android:paddingHorizontal="10dp" android:paddingVertical="4dp" android:layout_alignParentEnd="true" android:layout_centerVertical="true" />
            </RelativeLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Fortalecimiento de valores éticos para estudiantes y colaboradores del equipo COLUA." android:textColor="#333333" android:textSize="13sp" android:lineSpacingMultiplier="1.2" android:fontFamily="@font/poppins_regular" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Card 5: Nuestra Historia y Raíces -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="@color/white">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nuestra Historia y Raíces" android:textColor="@color/colua_navy" android:textSize="20sp" android:textStyle="bold" android:fontFamily="@font/poppins_regular" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Desde el 22 de mayo de 1965" android:textColor="#555555" android:textSize="12sp" android:fontFamily="@font/poppins_regular" android:layout_marginBottom="12dp" />

            <!-- Missing image fallback to sin_conexion as requested -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:src="@drawable/sin_conexion"
                android:scaleType="centerInside"
                android:layout_marginBottom="12dp"
                android:contentDescription="Historia" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="COLUA MICOOPE nació gracias al coraje de 25 visionarios guiados por la misionera Elena Harding. Con un aporte inicial de Q5.00 y cuotas semanales de Q0.25, demostraron que la solidaridad comunitaria es el motor financiero más poderoso." android:textColor="#333333" android:textSize="13sp" android:lineSpacingMultiplier="1.3" android:fontFamily="@font/poppins_regular" android:layout_marginBottom="16dp" />

            <!-- 3 Stats Boxes -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="3" android:baselineAligned="false">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="@drawable/circle_background" android:backgroundTint="#F1F5F9" android:padding="12dp" android:layout_marginEnd="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="60" android:textColor="@color/colua_navy" android:textSize="20sp" android:textStyle="bold" android:fontFamily="@font/poppins_regular" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Años de solidez" android:textColor="#555555" android:textSize="10sp" android:gravity="center" android:fontFamily="@font/poppins_regular" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="@drawable/circle_background" android:backgroundTint="#F1F5F9" android:padding="12dp" android:layout_marginHorizontal="3dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="25" android:textColor="@color/colua_navy" android:textSize="20sp" android:textStyle="bold" android:fontFamily="@font/poppins_regular" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Socios pioneros" android:textColor="#555555" android:textSize="10sp" android:gravity="center" android:fontFamily="@font/poppins_regular" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="@drawable/circle_background" android:backgroundTint="#F1F5F9" android:padding="12dp" android:layout_marginStart="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Q5.00" android:textColor="@color/colua_navy" android:textSize="18sp" android:textStyle="bold" android:fontFamily="@font/poppins_regular" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Capital semilla" android:textColor="#555555" android:textSize="10sp" android:gravity="center" android:fontFamily="@font/poppins_regular" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Card 6: Propuesta de Valor Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="@color/colua_navy">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NUESTRA PROPUESTA DE VALOR" android:textColor="#94A3B8" android:textSize="12sp" android:textStyle="bold" android:fontFamily="@font/poppins_regular" android:layout_marginBottom="8dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="“En COLUA reconocemos tu valor como persona para alcanzar tu bienestar integral y el de tu familia.”" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold" android:fontFamily="@font/poppins_regular" android:lineSpacingMultiplier="1.2" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Card 7: Huella e Impacto Social -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="@color/white">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Huella e Impacto Social" android:textColor="@color/colua_navy" android:textSize="20sp" android:textStyle="bold" android:fontFamily="@font/poppins_regular" android:layout_alignParentStart="true" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sololá &amp; Occidente" android:textColor="#2E7D32" android:textSize="12sp" android:textStyle="bold" android:background="@drawable/circle_background" android:backgroundTint="#E8F5E9" android:paddingHorizontal="10dp" android:paddingVertical="4dp" android:layout_alignParentEnd="true" />
            </RelativeLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Bienestar comunitario durante 2025" android:textColor="#555555" android:textSize="12sp" android:fontFamily="@font/poppins_regular" android:layout_marginBottom="16dp" />

            <!-- Stats 2 columns -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="2" android:baselineAligned="false" android:layout_marginBottom="16dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:background="@drawable/circle_background" android:backgroundTint="#F1F5F9" android:padding="16dp" android:layout_marginEnd="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DIRECTAS" android:textColor="#555555" android:textSize="10sp" android:textStyle="bold" android:fontFamily="@font/poppins_regular" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="22,775" android:textColor="@color/colua_navy" android:textSize="24sp" android:textStyle="bold" android:fontFamily="@font/poppins_regular" android:layout_marginTop="4dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="personas beneficiadas" android:textColor="#555555" android:textSize="11sp" android:fontFamily="@font/poppins_regular" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:background="@drawable/circle_background" android:backgroundTint="#F1F5F9" android:padding="16dp" android:layout_marginStart="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="INDIRECTAS" android:textColor="#555555" android:textSize="10sp" android:textStyle="bold" android:fontFamily="@font/poppins_regular" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="18,672" android:textColor="#2E7D32" android:textSize="24sp" android:textStyle="bold" android:fontFamily="@font/poppins_regular" android:layout_marginTop="4dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="asociados y comunidad" android:textColor="#555555" android:textSize="11sp" android:fontFamily="@font/poppins_regular" />
                </LinearLayout>
            </LinearLayout>

            <!-- Vidas Tocadas Card (Clickable to web) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_vidas_tocadas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/colua_navy"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_alignParentStart="true" android:layout_toStartOf="@id/iv_arrow_web">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="IMPACTO GLOBAL ACUMULADO" android:textColor="#94A3B8" android:textSize="10sp" android:textStyle="bold" android:fontFamily="@font/poppins_regular" android:layout_marginBottom="2dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="41,447 vidas\ntocadas" android:textColor="@color/white" android:textSize="22sp" android:textStyle="bold" android:fontFamily="@font/poppins_regular" android:lineSpacingMultiplier="1.1" />
                    </LinearLayout>
                    <ImageView
                        android:id="@+id/iv_arrow_web"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/colua_green"
                        android:contentDescription="Ir a web" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Card 8: ¿Quieres ser parte de este impacto? -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="#2E7D32">
        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="24dp">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_alignParentStart="true" android:layout_toStartOf="@id/btn_unirme" android:layout_marginEnd="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="¿Quieres ser parte de este impacto?" android:textColor="@color/white" android:textSize="18sp" android:textStyle="bold" android:fontFamily="@font/poppins_regular" android:layout_marginBottom="6dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Conoce cómo asociarte y acceder a los programas sociales." android:textColor="#E2E8F0" android:textSize="12sp" android:fontFamily="@font/poppins_regular" android:lineSpacingMultiplier="1.2" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_unirme"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="Unirme"
                android:textAllCaps="false"
                android:textColor="@color/colua_navy"
                app:backgroundTint="@color/white"
                app:cornerRadius="22dp"
                android:fontFamily="@font/poppins_regular"
                android:textSize="14sp"
                android:textStyle="bold" />
        </RelativeLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
