<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Título Principal del Modal -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_regular"
        android:text="Seleccionar Tipo de Elemento"
        android:textColor="@color/colua_navy"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/poppins_regular"
        android:text="Elige el tipo de bloque para configurar sus propiedades en el canvas:"
        android:textColor="@color/text_grey"
        android:textSize="12sp" />

    <!-- Campo de Búsqueda -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/circle_background"
        android:backgroundTint="#F8FAFC"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="Buscar"
            android:src="@drawable/ic_search"
            app:tint="#94A3B8" />

        <EditText
            android:id="@+id/et_search_element_type"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:background="@null"
            android:fontFamily="@font/poppins_regular"
            android:hint="Buscar bloque o componente..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:textColor="#1E293B"
            android:textColorHint="#94A3B8"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Filtro de Categorías / Chips Horizontales -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_categories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_all"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Todos"
                android:textColor="@color/colua_navy"
                app:chipBackgroundColor="#F1F5F9" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_basics"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Básicos"
                android:textColor="@color/colua_navy"
                app:chipBackgroundColor="#F1F5F9" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_media"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Multimedia"
                android:textColor="@color/colua_navy"
                app:chipBackgroundColor="#F1F5F9" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_structure"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Estructura"
                android:textColor="@color/colua_navy"
                app:chipBackgroundColor="#F1F5F9" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_financial"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Financiero"
                android:textColor="@color/colua_navy"
                app:chipBackgroundColor="#F1F5F9" />

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Lista de Elementos (RecyclerView de Tarjetas) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_element_types"
        android:layout_width="match_parent"
        android:layout_height="340dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:scrollbars="vertical" />

    <!-- Botón Cancelar -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_cancel_dialog"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/poppins_regular"
        android:text="Cancelar"
        android:textColor="@color/colua_navy"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="#F1F5F9"
        app:cornerRadius="12dp" />

</LinearLayout>
