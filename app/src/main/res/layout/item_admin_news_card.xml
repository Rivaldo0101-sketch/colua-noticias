<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E2E8F0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header: NOTICIA DESTACADA #1 + Badge Publicado -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F8FAFC"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/tv_news_featured_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:fontFamily="@font/poppins_regular"
                android:text="🟢 NOTICIA DESTACADA #1"
                android:textColor="#2E7D32"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_news_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/circle_background"
                android:backgroundTint="#E8F5E9"
                android:fontFamily="@font/poppins_regular"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="✔ Publicado"
                android:textColor="#2E7D32"
                android:textSize="10sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E2E8F0" />

        <!-- Cuerpo de Noticia: Imagen + Título, Subtítulo, Fecha, Likes -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp">

            <RelativeLayout
                android:id="@+id/layout_admin_news_thumb_container"
                android:layout_width="88dp"
                android:layout_height="88dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="12dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/iv_news_thumb"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/grupo" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tv_photos_count_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/circle_background"
                    android:backgroundTint="#B3000000"
                    android:fontFamily="@font/poppins_regular"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:text="📷 3 fotos"
                    android:textColor="@color/white"
                    android:textSize="9sp" />
            </RelativeLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_news_card_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_regular"
                    android:maxLines="1"
                    android:text="Jornada de Reforestación 2026"
                    android:textColor="@color/black"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_news_card_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_regular"
                    android:maxLines="2"
                    android:text="¡Compromiso verde! Junto a nuestros asociados y voluntarios logramos..."
                    android:textColor="@color/text_grey"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_news_card_date"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_regular"
                        android:text="📅 24 Feb, 2026"
                        android:textColor="@color/text_grey"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_news_likes_count"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/poppins_regular"
                        android:text="❤️ 0 me gusta  •  🔁 0 compartidos"
                        android:textColor="#E42A67"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

        <!-- Barra de Acción Configurada -->
        <TextView
            android:id="@+id/tv_news_action_target"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F1F5F9"
            android:fontFamily="@font/poppins_regular"
            android:paddingHorizontal="14dp"
            android:paddingVertical="4dp"
            android:text="🔗 Acción: Ver detalles completos (INFORMATIVO)"
            android:textColor="#334155"
            android:textSize="10sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E2E8F0" />

        <!-- Controles del Canvas CMS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FAFAFA"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingVertical="4dp">

            <ImageButton
                android:id="@+id/btn_move_up"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Subir"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/punta_de_flecha_hacia_arriba"
                app:tint="@color/colua_navy" />

            <ImageButton
                android:id="@+id/btn_move_down"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Bajar"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/punta_de_flecha_hacia_abajo"
                app:tint="@color/colua_navy" />

            <View
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:background="#E2E8F0" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_edit_item"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:fontFamily="@font/poppins_regular"
                android:text="Editar"
                android:textColor="@color/colua_navy"
                android:textSize="11sp"
                app:icon="@drawable/editar"
                app:iconSize="16dp" />

            <ImageButton
                android:id="@+id/btn_duplicate_item"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Duplicar"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/duplicar" />

            <ImageButton
                android:id="@+id/btn_toggle_visibility"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Vista previa"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ver" />

            <ImageButton
                android:id="@+id/btn_delete_item"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Eliminar"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/borrar" />

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
