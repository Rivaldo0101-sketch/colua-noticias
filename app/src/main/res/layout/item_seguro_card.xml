<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="20dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Left Accent Bar -->
            <View
                android:id="@+id/card_seguro_accent"
                android:layout_width="6dp"
                android:layout_height="match_parent"
                android:background="#EF8819" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center">

                <ImageView
                    android:id="@+id/card_seguro_logo"
                    android:layout_width="260dp"
                    android:layout_height="110dp"
                    android:layout_marginBottom="16dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="Logo de Seguro" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_solicitar_seguro"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Solicitar Información →"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/colua_navy"
                    app:cornerRadius="24dp"
                    android:fontFamily="@font/poppins_regular"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
