<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="20dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <ImageView
            android:id="@+id/card_beneficio_icon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginBottom="16dp"
            android:scaleType="fitCenter"
            android:contentDescription="Icono de Beneficio" />

        <TextView
            android:id="@+id/card_beneficio_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Renta Diaria por Hospitalización"
            android:textColor="@color/colua_navy"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:fontFamily="@font/poppins_regular"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/card_beneficio_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="La cooperativa apoya económicamente al asociado..."
            android:textColor="#333333"
            android:textSize="13sp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:fontFamily="@font/poppins_regular" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
