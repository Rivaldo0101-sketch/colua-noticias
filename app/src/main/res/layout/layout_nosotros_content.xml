<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:paddingBottom="60dp">

    <!-- Header Nosotros -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Nosotros"
        android:textColor="@color/colua_navy"
        android:textSize="28sp"
        android:textStyle="bold"
        android:fontFamily="@font/poppins_regular" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="24dp"
        android:text="El lado humano de los ahorros y créditos."
        android:textColor="#555555"
        android:textSize="14sp"
        android:fontFamily="@font/poppins_regular" />

    <!-- Card 1: Propuesta de Valor -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Green Left Accent Bar -->
            <View
                android:layout_width="6dp"
                android:layout_height="match_parent"
                android:background="#59B8A4" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_verified"
                        app:tint="#59B8A4"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="Propuesta de valor" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Propuesta de Valor"
                        android:textColor="@color/colua_navy"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins_regular" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="&quot;En COLUA reconocemos tu valor como persona para alcanzar tu bienestar integral y el de tu familia, a través de productos y servicios financieros éticos, ágiles y accesibles, basados en el poder de la cooperación&quot;."
                    android:textColor="#333333"
                    android:textSize="14sp"
                    android:lineSpacingMultiplier="1.2"
                    android:fontFamily="@font/poppins_regular" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Card 2: Visión -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Blue Left Accent Bar -->
            <View
                android:layout_width="6dp"
                android:layout_height="match_parent"
                android:background="@color/colua_navy" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_info"
                        app:tint="@color/colua_navy"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="Visión" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Visión"
                        android:textColor="@color/colua_navy"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins_regular" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="&quot;Ser un modelo de desarrollo y sostenibilidad integral de las comunidades basado en la cooperación&quot;."
                    android:textColor="#333333"
                    android:textSize="14sp"
                    android:lineSpacingMultiplier="1.2"
                    android:fontFamily="@font/poppins_regular" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Card 3: Propósito Visionario -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Red/Pink Left Accent Bar -->
            <View
                android:layout_width="6dp"
                android:layout_height="match_parent"
                android:background="#E42A67" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_campaign"
                        app:tint="#E42A67"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="Propósito Visionario" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Propósito Visionario"
                        android:textColor="@color/colua_navy"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins_regular" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="&quot;Ser la cooperativa financiera que mejora la calidad de vida de sus asociados y comunidades de Guatemala&quot;."
                    android:textColor="#333333"
                    android:textSize="14sp"
                    android:lineSpacingMultiplier="1.2"
                    android:fontFamily="@font/poppins_regular" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Header: Valores de COLUA MICOOPE -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp"
        android:text="Valores de COLUA MICOOPE"
        android:textColor="@color/colua_navy"
        android:textSize="22sp"
        android:textStyle="bold"
        android:fontFamily="@font/poppins_regular"
        android:gravity="center" />

    <!-- Valor 1: INTEGRIDAD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_marginBottom="20dp"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="INTEGRIDAD"
            android:textColor="@color/colua_navy"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins_regular"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Actuar con coherencia con nuestros valores, manteniendo transparencia en todo lo que hacemos y fomentando la cooperación en cada acción."
            android:textColor="#333333"
            android:textSize="13sp"
            android:gravity="center"
            android:fontFamily="@font/poppins_regular" />
    </LinearLayout>

    <!-- Two columns for Cooperación and Responsabilidad -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp"
        android:weightSum="2">

        <!-- Cooperación -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="COOPERACIÓN"
                android:textColor="@color/colua_navy"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins_regular" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Trabajar juntos para alcanzar un objetivo común, basada en la ayuda mutua, la solidaridad y el esfuerzo compartido."
                android:textColor="#333333"
                android:textSize="12sp"
                android:fontFamily="@font/poppins_regular" />
        </LinearLayout>

        <!-- Responsabilidad -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RESPONSABILIDAD"
                android:textColor="@color/colua_navy"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins_regular"
                android:gravity="end" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Administramos y cuidamos los ahorros de nuestros asociados que nos han confiado."
                android:textColor="#333333"
                android:textSize="12sp"
                android:gravity="end"
                android:fontFamily="@font/poppins_regular" />
        </LinearLayout>
    </LinearLayout>

    <!-- Imagen Central: valores_colua_1 -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginVertical="16dp"
        android:scaleType="fitCenter"
        android:src="@drawable/valores_colua_1"
        android:contentDescription="Valores COLUA MICOOPE Gráfico" />

    <!-- Valor Final: ENFOQUE AL ASOCIADO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_marginTop="12dp"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ENFOQUE AL ASOCIADO"
            android:textColor="@color/colua_navy"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins_regular"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="El centro de atención de nuestros esfuerzos y nuestra lealtad son los asociados, a quienes entregamos siempre soluciones de calidad."
            android:textColor="#333333"
            android:textSize="13sp"
            android:gravity="center"
            android:fontFamily="@font/poppins_regular" />
    </LinearLayout>

</LinearLayout>
