<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ColuaInformativa" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/colua_navy</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/colua_green</item>
        <item name="colorTertiary">@color/colua_orange</item>
        <item name="android:windowBackground">@color/background_light</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="android:statusBarColor">@color/colua_navy</item>
        <item name="android:navigationBarColor">@color/colua_navy</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>

    <style name="Theme.ColuaInformativa" parent="Base.Theme.ColuaInformativa" />

    <!-- Tema Forzado Claro para la Barra Lateral (Sidebar / Drawer) -->
    <style name="Theme.LightNavigation" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:colorBackground">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="colorOnSurfaceVariant">@color/colua_navy</item>
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:textColorSecondary">@color/text_grey</item>
    </style>

    <style name="App.CustomActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">#22449E</item>
        <item name="android:width">60dp</item>
        <item name="android:height">48dp</item>
    </style>
</resources>
